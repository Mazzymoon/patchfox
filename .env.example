# PatchFox does not automatically load project .env files.
# Prefer `patchfox config init`, which writes user-scoped configuration under
# ~/.patchfox. These variables remain available as explicit process overrides
# for CI or temporary runs.

PATCHFOX_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional generic one-run overrides.
PATCHFOX_API_KEY=
PATCHFOX_BASE_URL=
PATCHFOX_MODEL=

# Optional comma-separated extra env names to redact from traces and reports.
PATCHFOX_SECRET_ENV_NAMES=
